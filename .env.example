# Copia este fichero a .env (o .env.local) y ajusta los valores.

# Webhook de n8n que recibe la imagen y la lista de campos y devuelve el OCR.
# Producción: https://n8n.neo-n8n.com/webhook/ocr-vision
# Para probar el flujo desde el editor de n8n usa la URL de test:
#   https://n8n.neo-n8n.com/webhook-test/ocr-vision
VITE_OCR_WEBHOOK_URL=https://n8n.neo-n8n.com/webhook/ocr-vision
